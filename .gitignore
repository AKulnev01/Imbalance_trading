!online/**/__init__.py
!online/**/*.md

# ============================================================
# Pipeline generated test outputs / private validation artifacts
# ============================================================
pipeline/test/
production/pipeline/test/

# Backup files
*.bak
*.bak_*
*.backup
*.old

# Разрешаем только Python-код, если он лежит внутри test-папок
!pipeline/test/**/*.py
!pipeline/test/**/__init__.py
!pipeline/test/**/*.md
!production/pipeline/test/**/*.py
!production/pipeline/test/**/__init__.py
!production/pipeline/test/**/*.md


# =====================================================================
# Never publish local runtime config files, even inside online/
# =====================================================================
config.py
**/config.py
!config.example.py
!**/config.example.py
