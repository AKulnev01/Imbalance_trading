# models/evaluate_momentum.py
# — оффлайн зеркало лайва + хронологический режим (--sequential)

import os
import math
import pandas as pd
import numpy as np
from datetime import datetime, timezone
from evaluate_common import (
    get_cfg, INITIAL_CAPITAL, POSITION_FRACTION, DEFAULT_TTL_DAYS,
    to_utc_safe, fetch_ltf_window, load_price_cache, load_signals,
    enforce_one_at_a_time_per_symbol, simulate_capital_notional,
    safe_group_exit_reason, finalize_write, calc_sl_tp,
)

# ---------------------------------------------------------------------
# параметры и хелперы
# ---------------------------------------------------------------------

USE_FIB_4H = bool(get_cfg("USE_FIB_4H", cast=bool, default=False))
USE_DIV_4H = bool(get_cfg("USE_DIV_4H", cast=bool, default=False))
USE_OBOS_4H = bool(get_cfg("USE_OBOS_4H", cast=bool, default=False))

FIB_4H_LOOKBACK_BARS = int(get_cfg("FIB_4H_LOOKBACK_BARS", cast=int, default=120))
FIB_4H_PIVOT_LEN = int(get_cfg("FIB_4H_PIVOT_LEN", cast=int, default=3))
FIB_SET = [float(x) for x in str(get_cfg("FIB_SET", cast=str, default="0.236,0.382,0.5,0.618,0.786,1.0,1.272,1.618")).split(",")]
FIB_TP_INDEX = int(get_cfg("FIB_TP_INDEX", cast=int, default=3))
FIB_SL_MODE = str(get_cfg("FIB_SL_MODE", cast=str, default="current")).strip().lower()

DIV4H_TYPE = str(get_cfg("DIV4H_TYPE", cast=str, default="off")).strip().lower()
RSI_PERIOD = int(get_cfg("RSI_PERIOD", cast=int, default=14))
MACD_FAST = int(get_cfg("MACD_FAST", cast=int, default=12))
MACD_SLOW = int(get_cfg("MACD_SLOW", cast=int, default=26))
MACD_SIGNAL = int(get_cfg("MACD_SIGNAL", cast=int, default=9))
DIV4H_PIVOT_LEN = int(get_cfg("DIV4H_PIVOT_LEN", cast=int, default=3))
DIV4H_LOOKBACK_BARS = int(get_cfg("DIV4H_LOOKBACK_BARS", cast=int, default=120))
DIV4H_CONFIRM_BARS = int(get_cfg("DIV4H_CONFIRM_BARS", cast=int, default=2))
DIV4H_POLICY = str(get_cfg("DIV4H_POLICY", cast=str, default="tighten_tp")).strip().lower()
DIV_TIGHTEN_STEP = int(get_cfg("DIV_TIGHTEN_STEP", cast=int, default=1))

OBOS_TYPE = str(get_cfg("OBOS_TYPE", cast=str, default="off")).strip().lower()
OB_RSI_OB = float(get_cfg("OB_RSI_OB", cast=float, default=70.0))
OB_RSI_OS = float(get_cfg("OB_RSI_OS", cast=float, default=30.0))
STO_K = int(get_cfg("STO_K", cast=int, default=14))
STO_D = int(get_cfg("STO_D", cast=int, default=3))
STO_SMA = int(get_cfg("STO_SMA", cast=int, default=3))
OB_STOCH_OB = float(get_cfg("OB_STOCH_OB", cast=float, default=80.0))
OB_STOCH_OS = float(get_cfg("OB_STOCH_OS", cast=float, default=20.0))
OB_WPR_OB = float(get_cfg("OB_WPR_OB", cast=float, default=-20.0))
OB_WPR_OS = float(get_cfg("OB_WPR_OS", cast=float, default=-80.0))
OB_CCI_OB = float(get_cfg("OB_CCI_OB", cast=float, default=100.0))
OB_CCI_OS = float(get_cfg("OB_CCI_OS", cast=float, default=-100.0))
OBOS_POLICY = str(get_cfg("OBOS_POLICY", cast=str, default="tp_bias")).strip().lower()

TAKE_PCT = float(get_cfg("MOMENTUM_TP_PCT", cast=float))
STOP_PCT = float(get_cfg("MOMENTUM_SL_PCT", cast=float))
FEE_TAKER = float(get_cfg("FEE_TAKER", cast=float, default=0.0))

SLIPPAGE_PCT_DEFAULT = float(get_cfg("SLIPPAGE_PCT", cast=float, default=0.003))
ENTRY_SLIPPAGE_PCT = float(get_cfg("ENTRY_SLIPPAGE_PCT", cast=float, default=SLIPPAGE_PCT_DEFAULT))
EXIT_SLIPPAGE_PCT = float(get_cfg("EXIT_SLIPPAGE_PCT", cast=float, default=SLIPPAGE_PCT_DEFAULT))
STOP_SLIPPAGE_PCT = float(get_cfg("STOP_SLIPPAGE_PCT", cast=float, default=EXIT_SLIPPAGE_PCT))

DISABLE_MINUTE_FALLBACK = bool(get_cfg("DISABLE_MINUTE_FALLBACK", cast=bool, default=False))
MINUTE_EXIT_FOR_SINGLE = bool(get_cfg("MINUTE_EXIT_FOR_SINGLE", cast=bool, default=True))

# ---------------------------------------------------------------------
# основной расчёт
# ---------------------------------------------------------------------
def evaluate_momentum(signals_path, result_path,
                      lookback_days=360, interval="4h",
                      max_days=None, only_filled=False, dedup=False,
                      initial_capital=None, capital_aware=True,
                      sequential=False, max_concurrent=None, *,
                      price_cache=None):

    try:
        as_of = datetime.fromtimestamp(os.path.getmtime(signals_path), tz=timezone.utc)
    except Exception:
        as_of = datetime.now(tz=timezone.utc)

    df_sig = load_signals(signals_path, only_filled=only_filled, dedup=dedup, require_entry=False)
    if "type" not in df_sig.columns and "side" in df_sig.columns:
        df_sig["type"] = df_sig["side"]
    if df_sig.empty:
        finalize_write(result_path, pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame())
        return

    df_sig["type"] = df_sig["type"].astype(str).str.upper().replace({"LONG": "BUY", "SHORT": "SELL"})
    symbols = df_sig["symbol"].dropna().unique().tolist()

    if price_cache is None:
        price_cache = load_price_cache(symbols, interval=interval, lookback_days=lookback_days)

    # собираем сделки
    results = []
    for _, row in df_sig.iterrows():
        symbol, side, t0 = row["symbol"], row["type"], to_utc_safe(row["imb_time"])
        df4h = price_cache.get(symbol)
        if df4h is None or df4h.empty or side not in ("BUY", "SELL") or pd.isna(t0):
            continue
        entry_at, entry_px_ref = to_utc_safe(t0), float(df4h[df4h.index < t0]["close"].iloc[-1]) if not df4h[df4h.index < t0].empty else np.nan
        if math.isnan(entry_px_ref): continue
        entry_px_adj = entry_px_ref * (1 + ENTRY_SLIPPAGE_PCT if side == "BUY" else 1 - ENTRY_SLIPPAGE_PCT)
        sl_eval, tp_eval = calc_sl_tp(entry_px_adj, side, STOP_PCT, TAKE_PCT / STOP_PCT)
        ttl_days = int(DEFAULT_TTL_DAYS if max_days is None else max_days)
        window_end = min(t0 + pd.Timedelta(days=ttl_days), as_of)

        win, close_time, trigger_price, exit_reason, lt_res = fetch_exit(df4h, symbol, side, entry_at, sl_eval, tp_eval, window_end)
        exit_action = "SELL" if side == "BUY" else "BUY"
        exit_px_adj = trigger_price * (1 - STOP_SLIPPAGE_PCT if exit_reason == "sl" else 1 - EXIT_SLIPPAGE_PCT) if side == "BUY" \
            else trigger_price * (1 + STOP_SLIPPAGE_PCT if exit_reason == "sl" else 1 + EXIT_SLIPPAGE_PCT)
        pnl_pct_net = ((exit_px_adj - entry_px_adj) / entry_px_adj * 100 if side == "BUY"
                       else (entry_px_adj - exit_px_adj) / entry_px_adj * 100) - FEE_TAKER * 200

        results.append({
            "symbol": symbol, "type": side, "imb_time": t0, "t_start": entry_at,
            "entry": entry_px_adj, "stop": sl_eval, "tp": tp_eval,
            "win": win, "pnl_pct": pnl_pct_net,
            "close_time": close_time, "exit_reason": exit_reason,
            "lt_resolution": lt_res, "skipped": False,
            "as_of": as_of, "variant": "MOMENTUM"
        })

    df = pd.DataFrame(results)
    if df.empty:
        finalize_write(result_path, pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame()); return

    # хронологическая аллокация капитала
    if sequential:
        seq = df.sort_values(["t_start", "imb_time"]).reset_index(drop=True)
        init_cap = float(initial_capital or INITIAL_CAPITAL or 0)
        pos_frac = float(POSITION_FRACTION or 0.0)
        max_conc = int(max_concurrent or get_cfg("MAX_CONCURRENT_POSITIONS", cast=int, default=3))
        equity, free = init_cap, init_cap
        open_pos, out_rows = [], []

        def flush_until(ts):
            nonlocal equity, free, open_pos
            keep = []
            for p in open_pos:
                if pd.to_datetime(p["close_time"], utc=True) <= pd.to_datetime(ts, utc=True):
                    ret = float(p["pnl_pct"]) / 100
                    equity = equity - p["usd_alloc"] + p["usd_alloc"] * (1 + ret)
                    free += p["usd_alloc"] * (1 + ret)
                else:
                    keep.append(p)
            open_pos = keep

        for _, r in seq.iterrows():
            flush_until(r["t_start"])
            usd_alloc, allow = 0.0, True
            if len(open_pos) >= max_conc or free <= 0:
                allow = False
            else:
                usd_alloc = free * pos_frac
            if not allow:
                rr = r.to_dict(); rr.update({"usd_alloc": 0.0, "pnl_usd": 0.0, "skipped": True})
                out_rows.append(rr); continue
            free -= usd_alloc
            open_pos.append({"symbol": r["symbol"], "close_time": r["close_time"],
                             "usd_alloc": usd_alloc, "pnl_pct": r["pnl_pct"]})
            pnl_usd = usd_alloc * r["pnl_pct"] / 100
            rr = r.to_dict(); rr.update({"usd_alloc": usd_alloc, "pnl_usd": pnl_usd})
            out_rows.append(rr)

        flush_until(as_of)
        df = pd.DataFrame(out_rows)
        eq_sheet = pd.DataFrame({"metric": ["initial_equity", "final_equity"],
                                 "value": [init_cap, equity]})
    else:
        sim_out, eq_sheet = simulate_capital_notional(df, float(initial_capital or INITIAL_CAPITAL or 0),
                                                      POSITION_FRACTION, stop_pct=STOP_PCT, take_pct=TAKE_PCT)
        for col in ("usd_alloc", "pnl_usd"):
            if col in sim_out.columns: df[col] = sim_out[col]

    by_variant = df.groupby("variant").agg(
        trades=("win","size"), wins=("win","sum"),
        winrate_pct=("win", lambda s: round(100 * s.sum() / max(1,len(s)),2)),
        pnl_pct=("pnl_pct","sum"), pnl_usd=("pnl_usd","sum")
    ).reset_index()
    by_exit_reason = safe_group_exit_reason(df)
    for c in ["imb_time","t_start","close_time","as_of"]:
        if c in df.columns:
            s = pd.to_datetime(df[c], errors="coerce", utc=True)
            df[c] = s.dt.tz_convert(None)
    finalize_write(result_path, df, eq_sheet, by_variant, by_exit_reason)
    print(f"✅ MOMENTUM eval saved → {result_path}")

def fetch_exit(df4h, symbol, side, entry_at, sl_eval, tp_eval, t_end):
    if df4h is None or df4h.empty: return None, pd.NaT, np.nan, "no_data", "4h"
    bars = df4h[(df4h.index >= entry_at) & (df4h.index < t_end)]
    for ts, c in bars.iterrows():
        hi, lo = float(c["high"]), float(c["low"])
        if side=="BUY":
            if hi>=tp_eval: return True, ts+pd.Timedelta(hours=4), tp_eval, "tp", "4h"
            if lo<=sl_eval: return False, ts+pd.Timedelta(hours=4), sl_eval, "sl", "4h"
        else:
            if lo<=tp_eval: return True, ts+pd.Timedelta(hours=4), tp_eval, "tp", "4h"
            if hi>=sl_eval: return False, ts+pd.Timedelta(hours=4), sl_eval, "sl", "4h"
    return False, bars.index[-1]+pd.Timedelta(hours=4) if not bars.empty else entry_at, \
           float(bars.iloc[-1]["close"] if not bars.empty else np.nan), "timeout_last_close","4h"

# ---------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------
if __name__ == "__main__":
    import argparse
    def _b(v): return str(v).lower() in ("1","true","yes","y","on")
    p = argparse.ArgumentParser()
    p.add_argument("signals")
    p.add_argument("--out", default=None)
    p.add_argument("--interval", default="4h")
    p.add_argument("--lookback-days", type=int, default=360)
    p.add_argument("--ttl-days", type=int, default=None)
    p.add_argument("--initial-capital", type=float, default=None)
    p.add_argument("--capital-aware", type=_b, default=True)
    p.add_argument("--only-filled", action="store_true")
    p.add_argument("--dedup", action="store_true")
    p.add_argument("--sequential", action="store_true", help="Хронологический прогон с капиталом")
    p.add_argument("--max-concurrent", type=int, default=None)
    args = p.parse_args()

    sig_path = os.path.expanduser(args.signals)
    out_path = os.path.expanduser(args.out) if args.out else os.path.splitext(sig_path)[0] + "_momentum_eval.xlsx"

    evaluate_momentum(
        signals_path=sig_path,
        result_path=out_path,
        lookback_days=args.lookback_days,
        interval=args.interval,
        max_days=args.ttl_days,
        only_filled=args.only_filled,
        dedup=args.dedup,
        initial_capital=args.initial_capital,
        capital_aware=args.capital_aware,
        sequential=args.sequential,
        max_concurrent=args.max_concurrent,
    )